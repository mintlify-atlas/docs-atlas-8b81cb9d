{
  "projectType": "cli-tool",
  "projectName": "sfsu",
  "projectDescription": "A blazing-fast Rust-based drop-in replacement and companion utility for the Scoop Windows package manager, delivering up to 100× faster equivalents of common Scoop commands.",
  "theme": "aspen",
  "primaryColor": "#00d1b2",
  "lightColor": "#24d35c",
  "darkColor": "#e8803c",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "installation",
              "quickstart"
            ]
          },
          {
            "group": "Usage",
            "pages": [
              "usage/hook",
              "usage/global-flags",
              "usage/configuration"
            ]
          },
          {
            "group": "Command Reference",
            "pages": [
              "commands/app",
